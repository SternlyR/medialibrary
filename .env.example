# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: Get a free API key at https://www.omdbapi.com/
OMDB_API_KEY=your_omdb_api_key_here

# Database path (defaults to ./medialibrary.db)
DATABASE_URL=sqlite+aiosqlite:///./medialibrary.db

# Optional: your public Letterboxd username — enables rating sync at add time
# and the `sync-ratings` CLI command / POST /sync/letterboxd API endpoint.
# No API key required; uses public profile scraping.
LETTERBOXD_USERNAME=your_letterboxd_username

# ── YouTube Shorts Dashboard ──────────────────────────────────────────────────
# Get a free API key at https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_key_here
# Your channel ID (found in YouTube Studio → Settings → Channel → Advanced)
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# How often to refresh data in minutes (default 15, minimum 5)
# At 15 min: ~9700 API quota units/day  (within free 10,000 limit)
# At 30 min: ~4850 API quota units/day  (very safe)
YOUTUBE_REFRESH_INTERVAL_MINUTES=15
